# Apache .htaccess file with redirects
# Generated by Codegen for ClickUp task: Add redirects to htaccess file

# Redirect from old-page to new-page
Redirect 301 /old-page /new-page

# Redirect from blog/old-post to blog/new-post
Redirect 301 /blog/old-post /blog/new-post

# Redirect from /test to google.com
Redirect 301 /test https://google.com
